BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_DEFAULT_PIPELINE=hybrid
BACKEND_OUTPUT_DIR=backend/runtime
BACKEND_ALLOWED_INPUT_ROOT=D:/AIGC
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ModelProvider settings used by hybrid mode.
MODEL_PROVIDER=lanxin
BACKEND_SECRETS_FILE=D:/AIGC/api
LANXIN_API_KEY=
LANXIN_BASE_URL=https://api-ai.vivo.com.cn/v1
LANXIN_MODEL=Doubao-Seed-2.0-mini
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_MODEL=deepseek-chat
MODEL_TIMEOUT_MS=90
LANXIN_RETRIES=1
