BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEFAULT_PIPELINE=rag-only
BACKEND_OUTPUT_DIR=runtime
BACKEND_ALLOWED_INPUT_ROOT=.
BACKEND_CORS_ORIGINS=*

# ModelProvider settings used by hybrid mode.
MODEL_PROVIDER=lanxin
# Point to a local file outside build artifacts. Do not package this file.
BACKEND_SECRETS_FILE=D:\AIGC\api
LANXIN_API_KEY=
LANXIN_BASE_URL=https://api-ai.vivo.com.cn/v1
LANXIN_MODEL=Doubao-Seed-2.0-mini
MODEL_TIMEOUT_MS=90
LANXIN_RETRIES=1

# Optional Lanxin general OCR. Enable per request with enableOcr=true.
LANXIN_APP_ID=
LANXIN_OCR_APP_ID=
LANXIN_OCR_APP_KEY=
LANXIN_OCR_BUSINESS_ID=
LANXIN_OCR_URL=http://api-ai.vivo.com.cn/ocr/general_recognition
LANXIN_OCR_POS=2
LANXIN_OCR_TIMEOUT_MS=15
LANXIN_OCR_RETRIES=1
